# Local: copy to .env. Production: Vercel → Project → Settings → Environment Variables.
# Keys stay empty in git; real ones only in .env and in Vercel.
# Without any key the app still works: /api/read-plan answers no_keys and the UI offers manual entry.

# 1. Google AI Studio: aistudio.google.com → Get API key
LLM_1_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_1_API_KEY=
LLM_1_MODEL=gemma-4-31b-it

# 2. Same key, another model with its own free limit (joins after 4 s)
LLM_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_2_API_KEY=
LLM_2_MODEL=gemini-flash-latest

# 3. Optional. OpenRouter: openrouter.ai → Keys (joins after 6 s)
LLM_3_BASE_URL=https://openrouter.ai/api/v1
LLM_3_API_KEY=
LLM_3_MODEL=google/gemma-4-31b-it:free

# AI answer cache: server only, only when every provider failed (not implemented yet, B4)
DEMO_CACHE=fallback

# Stripe test mode (Should, #15): dashboard.stripe.com → Developers → API keys, sk_test_ only
STRIPE_SECRET_KEY=
