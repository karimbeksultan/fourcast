# Local: copy to .env. Production: Vercel → Project → Settings → Environment Variables.
# Keys stay empty in git; real ones only in .env and in Vercel.
# Without any key the app still works: /api/read-plan answers no_keys and the UI offers manual entry.

# MODEL is a list, tried in order. Each model has its own small free daily quota; when one answers
# 429 (quota used up), 404 or 5xx, the next one takes over at once and the spent one is skipped for a while.
# The last model is the last resort and gets 40 s instead of 10: Gemma 4 31B thinks first (18-30 s)
# but has by far the largest free quota.
# Tested 14.11 on the Klarna sample: 3.5-flash-lite 0.8 s, 3.1-flash-lite-preview 3 s, 3-flash-preview 4 s,
# gemma-4-31b-it 18 s (once 503 after 42 s); 2.5-flash and 2.5-flash-lite are closed to new keys (404).

# 1. Google AI Studio: aistudio.google.com → Get API key
LLM_1_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_1_API_KEY=
LLM_1_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite,gemma-4-31b-it

# 2. Same key, other models with their own quotas (joins after 4 s)
LLM_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_2_API_KEY=
LLM_2_MODEL=gemini-3.1-flash-lite-preview,gemini-3-flash-preview,gemma-4-31b-it

# 3. Optional. OpenRouter: openrouter.ai → Keys (joins after 6 s)
LLM_3_BASE_URL=https://openrouter.ai/api/v1
LLM_3_API_KEY=
LLM_3_MODEL=google/gemma-4-31b-it:free

# AI answer cache: server only, only when every provider failed (not implemented yet, B4)
DEMO_CACHE=fallback

# Stripe test mode (Should, #15): dashboard.stripe.com → Developers → API keys, sk_test_ only
STRIPE_SECRET_KEY=
